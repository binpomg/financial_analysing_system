{
  "api": {
    "credential_source": "environment",
    "protocol": "responses",
    "base_url_env": "FIN_API_BASE_URL",
    "api_key_env": "FIN_API_KEY",
    "timeout_seconds": 1200,
    "max_output_tokens": 64000,
    "max_response_bytes": 16777216
  },
  "models": {
    "discovery": {
      "model": "gpt-5.6-luna",
      "reasoning_effort": "xhigh"
    },
    "business": {
      "model": "gpt-6-astra",
      "reasoning_effort": "xhigh"
    },
    "audit": {
      "model": "gpt-6-astra",
      "reasoning_effort": "xhigh"
    },
    "improvement": {
      "model": "gpt-6-astra",
      "reasoning_effort": "xhigh"
    }
  },
  "reading": {
    "max_input_characters": 600000,
    "max_images": 400,
    "max_image_bytes": 52428800
  },
  "sources": [
    {
      "adapter": "cninfo",
      "query": "中标",
      "lookback_days": 7,
      "page_size": 10,
      "max_pages": 1,
      "extensions": [
        ".pdf"
      ],
      "allowed_hosts": [
        "www.cninfo.com.cn",
        "static.cninfo.com.cn"
      ]
    },
    {
      "adapter": "cninfo",
      "query": "经营数据",
      "lookback_days": 7,
      "page_size": 10,
      "max_pages": 1,
      "extensions": [
        ".pdf"
      ],
      "allowed_hosts": [
        "www.cninfo.com.cn",
        "static.cninfo.com.cn"
      ]
    }
  ],
  "promotion_policy": {
    "enabled": false
  },
  "pipeline": {
    "max_documents": 1,
    "max_feedback_issues_per_run": 2,
    "min_feedback_cases": 3,
    "max_candidates_per_batch": 1
  },
  "default_enabled_lines": [
    "extraction",
    "financial-report",
    "industry-chain",
    "valuation",
    "report-factcheck",
    "investment-memo",
    "research-quality"
  ]
}
